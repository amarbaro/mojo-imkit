"""Regenerate src/imkit/vp8tab.mojo: the VP8 constant tables (RFC 6386 sections 13.4, 13.5, 11.5, 14.1) as packed text. The numbers
come from libwebp's BSD-licensed tables (src/dec/tree_dec.c, src/dec/quant_dec.c); counts are checked here and the decoder is checked
against libwebp's output by tests/webp_test.sh. Build-time tool, nothing here runs at decode time.
usage: mojo run tools/vp8_tables.mojo DIR   (DIR holds tree_dec.c and quant_dec.c:
       gh api repos/webmproject/libwebp/contents/src/dec/FILE --jq .content | base64 -d > DIR/FILE)"""
from std.sys import argv


def numbers(src: String, name: String, count: Int) raises -> List[Int]:
    """The integers of `static const ... name[...] = { ... };`, comments skipped."""
    var at = src.find(name + "[")
    if at < 0:
        raise Error("FAIL table: " + name + " not found")
    var b = src.as_bytes()
    var i = src.find("=", at) + 1
    var out = List[Int]()
    var v, have = 0, False
    while i < len(b) and b[i] != UInt8(ord(";")):
        if b[i] == UInt8(ord("/")) and b[i + 1] == UInt8(ord("/")):
            while b[i] != 10:
                i += 1
            continue
        if b[i] >= 48 and b[i] <= 57:
            v = v * 10 + Int(b[i]) - 48
            have = True
        elif have:
            out.append(v)
            v = 0
            have = False
        i += 1
    if len(out) != count:
        raise Error("FAIL table: " + name + " has " + String(len(out)) + " numbers, expected " + String(count))
    return out^


def emit(name: String, nums: List[Int]) -> String:
    var s = "\n\ndef " + name + "() -> List[Int]:\n    \"\"\"" + String(len(nums)) + " values.\"\"\"\n    return nums(\n"
    var line = String()
    for n in nums:
        line += String(n) + " "
        if line.byte_length() > 104:
            s += "        \"" + line + "\"\n"
            line = String()
    if line.byte_length() > 0:
        s += "        \"" + line + "\"\n"
    return s + "    )\n"


def main() raises:
    var d = argv()[1]
    var tree: String
    var quant: String
    with open(d + "/tree_dec.c", "r") as f:
        tree = f.read()
    with open(d + "/quant_dec.c", "r") as f:
        quant = f.read()
    var s = String('"""VP8 constant tables, generated by tools/vp8_tables.mojo (do not edit). Each table is text, parsed once per decode."""\n')
    s += "\n\ndef nums(s: StringSlice) -> List[Int]:\n    \"\"\"Space separated integers to a list.\"\"\"\n"
    s += "    var r = List[Int]()\n    var v, have = 0, False\n    for b in s.as_bytes():\n"
    s += "        if b >= 48 and b <= 57:\n            v = v * 10 + Int(b) - 48\n            have = True\n"
    s += "        elif have:\n            r.append(v)\n            v = 0\n            have = False\n    return r^\n"
    s += emit("coeff_proba", numbers(tree, "CoeffsProba0", 4 * 8 * 3 * 11))
    s += emit("coeff_update", numbers(tree, "CoeffsUpdateProba", 4 * 8 * 3 * 11))
    s += emit("bmode_proba", numbers(tree, "kBModesProba", 10 * 10 * 9))
    s += emit("dc_table", numbers(quant, "kDcTable", 128))
    s += emit("ac_table", numbers(quant, "kAcTable", 128))
    with open("src/imkit/vp8tab.mojo", "w") as f:
        f.write(s)
    print("PASS vp8_tables: wrote src/imkit/vp8tab.mojo")
