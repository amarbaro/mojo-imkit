"""AV1 default CDF and scan tables (spec section 10), generated by tools/av1_tables.mojo (do not edit).

Stored form of src/imkit/av1sym.mojo: each CDF of N symbols is N + 1 UInt16, entry i = 32768 - spec value, entry N - 1 = 0,
entry N = the adaptation counter (struct Cdfs). struct Scans holds the 32 scan orders.
CDF detail: A table is flat in the spec's index order: row r of a table with row length L starts at r * L.
The constant `<NAME>_N` is N (symbols per CDF) for each field. Tables are text, parsed once by Cdfs()."""


def u16s(s: StringSlice) -> List[UInt16]:
    """Space separated integers to a list."""
    var r = List[UInt16]()
    var v, have = 0, False
    for b in s.as_bytes():
        if b >= 48 and b <= 57:
            v = v * 10 + Int(b) - 48
            have = True
        elif have:
            r.append(UInt16(v))
            v = 0
            have = False
    return r^


def i32s(s: StringSlice) -> List[Int32]:
    """Space separated signed integers to a list."""
    var r = List[Int32]()
    var v, have, neg = 0, False, False
    for b in s.as_bytes():
        if b >= 48 and b <= 57:
            v = v * 10 + Int(b) - 48
            have = True
        else:
            if have:
                r.append(Int32(-v if neg else v))
                v, have, neg = 0, False, False
            neg = b == 45
    return r^

